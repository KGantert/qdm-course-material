%% ************************************************************************
% Quantitative Dynamic Macroeconomics
% Project: New-Keynesian (NK) Model with Capital and Fiscal Policy
% Extended model: scenario shocks and an optional fiscal block
% Konstantin Gantert
% 12/04/2026
% *************************************************************************
% The model equals the student baseline model (../dynare_student) plus
%   (i)  scenario shocks: cost-push (P), investment-specific (X), money velocity (V)
%        and COVID labor-wedge (C) shocks, all entering with a positive sign;
%   (ii) an optional fiscal block (government spending, public liabilities, a
%        lump-sum tax rule and the tax (T) and public-debt (L) shocks).
% The fiscal block is switched on with the macro variable "fiscal" (set in
% run_nk_model.m and passed to Dynare via -Dfiscal=1). All shocks are
% defined such that a positive innovation raises the shock process.
% ------------------------------------------------------------------------------
% Macro switch: fiscal block off by default
% ------------------------------------------------------------------------------
@#ifndef fiscal
    @#define fiscal = 0
@#endif

% Text snippets that are inserted into the equations of the model block:
%   TT, TTp: variable lump-sum tax rate today and tomorrow (zero without fiscal block)
%   GG:      government spending in the resource constraint
@#if fiscal == 1
    @#define TT  = "tauT"
    @#define TTp = "tauT(+1)"
    @#define GG  = "+ g_ss"
@#else
    @#define TT  = "0"
    @#define TTp = "0"
    @#define GG  = ""
@#endif

% ------------------------------------------------------------------------------
% I) Define Variables and Parameters
% ------------------------------------------------------------------------------

var
    // Observable Variables
    Y           ${Y}$           (long_name='Real Output')
    L           ${L}$           (long_name='Total Hours')
    K           ${K}$           (long_name='Capital Stock')
    X           ${X}$           (long_name='Capital Investment')
    C           ${C}$           (long_name='Real Consumption')
    w           ${w}$           (long_name='Real Wage')
    rK          ${r_K}$         (long_name='Real Rental Rate')
    rB          ${r_B}$         (long_name='Nominal Bond Interest Rate')
    mc          ${mc}$          (long_name='Real Marginal Costs')
    pii         ${\pi}$         (long_name='Price Inflation')
    m           ${m}$           (long_name='Money supply')
@#if fiscal == 1
    lg          ${l_g}$         (long_name='Government liabilities')
    tauT        ${\tau_T}$      (long_name='Variable lump-sum taxes')
@#endif

    // Marginal Utility & Penalty Prices
    muc         ${muc}$         (long_name='Marginal Utility out of Consumption')
    muu         ${\mu}$         (long_name='Budget Constraint Penalty Price')
    tet         ${\theta}$      (long_name='Capital Law of Motion Penalty Price')

    // Adjustment Cost Functions
    cp          ${c_P}$         (long_name='Price Adjustment Cost')
    cpp         ${c^\prime_P}$  (long_name='Marginal Price Adjustment Cost')
    ci          ${c_I}$         (long_name='Investment Adjustment Cost')
    cii         ${c^\prime_I}$  (long_name='Marginal Investment Adjustment Cost')

    // AR(1) Shock Processes - Exogenous Shocks
    sM          ${s_M}$         (long_name='Monetary policy shock process')
    sP          ${s_P}$         (long_name='Cost-push shock process')
    sZ          ${s_Z}$         (long_name='TFP shock process')
    sX          ${s_X}$         (long_name='Investment-specific productivity shock process')
    sV          ${s_V}$         (long_name='Money velocity shock process')
    sC          ${s_C}$         (long_name='COVID labor-wedge shock process')
@#if fiscal == 1
    sT          ${s_T}$         (long_name='Tax shock process')
    sL          ${s_L}$         (long_name='Public debt risk markup shock process')
@#endif
    ;

predetermined_variables
    K, muu                      // Here we we set our control variables with time indext "t+1" that are set in "t"!
@#if fiscal == 1
    , lg
@#endif
    ;

varexo          // Here we set our exogenous variables.
                // Note: AR(1) processes are endogenous to the model, only the shock is exogenous.
    eM          ${\varepsilon_M}$   (long_name='Monetary policy shock')
    eP          ${\varepsilon_P}$   (long_name='Cost-push shock')
    eZ          ${\varepsilon_Z}$   (long_name='TFP shock')
    eX          ${\varepsilon_X}$   (long_name='Investment-specific productivity shock')
    eV          ${\varepsilon_V}$   (long_name='Money velocity shock')
    eC          ${\varepsilon_C}$   (long_name='COVID labor-wedge shock')
@#if fiscal == 1
    eT          ${\varepsilon_T}$   (long_name='Tax shock')
    eL          ${\varepsilon_L}$   (long_name='Public debt risk markup shock')
@#endif
    ;

parameters
    // Deep parameters
    betta       ${\beta}$           (long_name='Period discount factor')
    sig         ${\sigma}$          (long_name='Intertemporal elasticity of substitution')
    gam         ${\gamma}$          (long_name='Inverse Frisch labor supply elasticity')
    vphi        ${\varphi}$         (long_name='Labor disutility level parameter')
    nuu         ${\nu}$             (long_name='Inverse money velocity')
    delK        ${\delta}$          (long_name='Private capital depreciation rate')
    alp         ${\alpha}$          (long_name='Capital elasticity w.r.t. output')
    rhoo        ${\rho}$            (long_name='Elasticity of substitution between differentiated goods')
    kap         ${\kappa}$          (long_name='Price adjustment cost parameter')
    phiX        ${\phi_X}$          (long_name='Investment adjustment cost')

    // Fiscal policy and taxes
    tauL        ${\tau_L}$          (long_name='Labor income tax')
    tauK        ${\tau_K}$          (long_name='Capital income tax')
    tauC        ${\tau_C}$          (long_name='Consumption tax')
@#if fiscal == 1
    gamLG       ${\gamma_{l_g}}$    (long_name='Fiscal rule coefficient w.r.t. government liabilities')
    lgY_ss      ${lg^Y_{ss}}$       (long_name='Public-debt-to-GDP steady-state target')
    g_ss        ${G_{ss}}$          (long_name='Government spending steady-state target')
@#endif

    // Monetary policy
    tetR        ${\theta_{R}}$      (long_name='Interest Rate Smoothing')
    tetPi       ${\theta_{\pi}}$    (long_name='Taylor Coefficient w.r.t. Inflation')
    tetY        ${\theta_{Y}}$      (long_name='Taylor Coefficient w.r.t. Real GDP')

    // Shock standard deviations
    stdM        ${\sigma_M}$        (long_name='Standard deviation monetary policy shock')
    stdP        ${\sigma_P}$        (long_name='Standard deviation cost-push shock')
    stdZ        ${\sigma_Z}$        (long_name='Standard deviation TFP shock')
    stdX        ${\sigma_X}$        (long_name='Standard deviation investment-specific productivity shock')
    stdV        ${\sigma_V}$        (long_name='Standard deviation money velocity shock')
    stdC        ${\sigma_C}$        (long_name='Standard deviation COVID labor-wedge shock')
@#if fiscal == 1
    stdT        ${\sigma_T}$        (long_name='Standard deviation tax shock')
    stdL        ${\sigma_L}$        (long_name='Standard deviation public debt risk markup shock')
@#endif

    // Shock autocorrelations
    rhoM        ${\rho_M}$          (long_name='Autocorrelation monetary policy shock')
    rhoP        ${\rho_P}$          (long_name='Autocorrelation cost-push shock')
    rhoZ        ${\rho_Z}$          (long_name='Autocorrelation TFP shock')
    rhoX        ${\rho_X}$          (long_name='Autocorrelation investment-specific productivity shock')
    rhoV        ${\rho_V}$          (long_name='Autocorrelation money velocity shock')
    rhoC        ${\rho_C}$          (long_name='Autocorrelation COVID labor-wedge shock')
@#if fiscal == 1
    rhoT        ${\rho_T}$          (long_name='Autocorrelation tax shock')
    rhoL        ${\rho_L}$          (long_name='Autocorrelation public debt risk markup shock')
@#endif
    ;

% Assigning values from Matlab workspace to the parameters
% ------------------------------------------------------------------------------
% Deep parameters - Households
set_param_value('betta',par.betta);
set_param_value('sig',par.sig);
set_param_value('nuu',par.nuu);
set_param_value('gam',par.gam);
set_param_value('delK',par.delK);
set_param_value('phiX',par.phiX);

% Deep parameters - Firms
set_param_value('alp',par.alp);
set_param_value('rhoo',par.rhoo);
set_param_value('kap',par.kap);

% Fiscal policy and taxes
set_param_value('tauL',par.tauL);
set_param_value('tauK',par.tauK);
set_param_value('tauC',par.tauC);
@#if fiscal == 1
set_param_value('gamLG',par.gamLG);
set_param_value('lgY_ss',par.lgY_ss);
@#endif

% Monetary policy
set_param_value('tetR',par.tetR);
set_param_value('tetPi',par.tetPi);
set_param_value('tetY',par.tetY);

% Shock standard deviations
set_param_value('stdM',par.stdM);
set_param_value('stdP',par.stdP);
set_param_value('stdZ',par.stdZ);
set_param_value('stdX',par.stdX);
set_param_value('stdV',par.stdV);
set_param_value('stdC',par.stdC);
@#if fiscal == 1
set_param_value('stdT',par.stdT);
set_param_value('stdL',par.stdL);
@#endif

% Shock autocorrelations
set_param_value('rhoM',par.rhoM);
set_param_value('rhoP',par.rhoP);
set_param_value('rhoZ',par.rhoZ);
set_param_value('rhoX',par.rhoX);
set_param_value('rhoV',par.rhoV);
set_param_value('rhoC',par.rhoC);
@#if fiscal == 1
set_param_value('rhoT',par.rhoT);
set_param_value('rhoL',par.rhoL);
@#endif

%-------------------------------------------------------------------------------
% II) Model Block
%-------------------------------------------------------------------------------

model;

%-------------------------------------------------------------------------------
% Sticky price economy
%-------------------------------------------------------------------------------

% Household
% ---------------------------------

[name='Marginal utility out of consumption']
muc     = C^(-sig);

[name='Labor supply']
w       = (1+tauC+@{TT}+sC)/(1-tauL-@{TT}-sC) * (vphi*L^gam) / (muu*muc);

[name='Money demand']
muu*(nuu*exp(sV))     = betta/(1+pii(+1))*muc(+1)/muc*(1+tauC+@{TT})/(1+tauC+@{TTp})*((1-muu(+1))+(nuu*exp(sV(+1)))*muu(+1));

[name='Euler equation (bond prices)']
muc     = betta* muu(+1)/muu*(1+tauC+@{TT})/(1+tauC+@{TTp}) * (1+rB)/(1+pii(+1)) * muc(+1);

[name='Capital allocation (Tobins Q/Euler equation)']
tet     = betta*exp(sX)/exp(sX(+1))*muc(+1)/muc*(1+tauC+@{TT})/(1+tauC+@{TTp})
            * ( tet(+1)*(1-delK) + muu(+1)*exp(sX(+1))*(rK(+1)*(1-tauK-@{TT})) );

[name='Optimal capital investment']
muu     = ( 1 - ci - cii ) * tet
            + betta*muc(+1)/muc*(1+tauC+@{TT})/(1+tauC+@{TTp}) * cii(+1) * (X(+1)/X) * tet(+1);

% Intermediate good firm
% ---------------------------------

[name='Labor demand']
w       = (1-alp)*mc*Y/L;

[name='Capital demand']
rK      = alp*mc*Y/K;

[name='NK Phillips curve']
cpp/(1-cp) = (1-rhoo/mc)/(1-rhoo) + (exp(sP)-1)
                + (1+pii(+1))/(1+rB) *Y(+1)/Y*mc(+1)/mc * cpp(+1)/(1-cp(+1));

% Constraints
% ---------------------------------

[name='Resource constraint']
Y       = C + X @{GG};

[name='Production function']
Y       = (1-cp) * (exp(sZ)*L)^(1-alp)*K^alp;

[name='Capital law of motion']
K(+1)   = (1-delK)*K + (1-ci)*exp(sX)*X;

[name='Cash-in-advance constraint']
m       = (nuu*exp(sV))*(1+tauC+@{TT})*C;

@#if fiscal == 1
[name='Government budget constraint']
lg(+1)  = (1+rB+sL)/(1+pii(+1))*lg - rB*m
            + (1+rB)*( g_ss-(tauC+tauT)*C-(tauL+tauT)*w*L-(tauK+tauT)*rK*K );
@#endif

% Adjustment cost functions
% ---------------------------------

[name='Price adjustment cost']
cp      = kap/2*pii^2;

[name='Marginal price adjustment cost']
cpp     = kap*pii*(1+pii);

[name='Investment adjustment cost']
ci      = phiX/2 * ( X/X(-1) - 1 )^2;

[name='Marginal investment adjustment cost']
cii     = phiX * ( X/X(-1) - 1 ) * X/X(-1);

% Policy rules
% ---------------------------------

[name='Interest rate rule']
((1+rB)/(1+steady_state(rB))) = ((1+rB(-1))/(1+steady_state(rB)))^tetR
                                * ((1+pii)/(1+steady_state(pii)))^((1-tetR)*tetPi)
                                * (Y/steady_state(Y))^((1-tetR)*tetY)
                                * exp(sM);

@#if fiscal == 1
[name='Fiscal policy rule']
tauT - steady_state(tauT)
        = gamLG * ( lg - steady_state(lg) ) + sT;
@#endif

%-------------------------------------------------------------------------------
% Exogenous processes (a positive innovation raises the shock process)
%-------------------------------------------------------------------------------

[name='Monetary policy shock process']
sM      = rhoM*sM(-1) + eM;

[name='Cost-push shock process']
sP      = rhoP*sP(-1) + eP;

[name='TFP shock process']
sZ      = rhoZ*sZ(-1) + eZ;

[name='Investment-specific productivity shock process']
sX      = rhoX*sX(-1) + eX;

[name='Money velocity shock process']
sV      = rhoV*sV(-1) + eV;

[name='COVID labor-wedge shock process']
sC      = rhoC*sC(-1) + eC;

@#if fiscal == 1
[name='Tax shock process']
sT      = rhoT*sT(-1) + eT;

[name='Public debt risk markup shock process']
sL      = rhoL*sL(-1) + eL;
@#endif

end;

%-------------------------------------------------------------------------------
% III) Steady-State Calculations
%-------------------------------------------------------------------------------

steady;

//resid;
//check;

%--------------------------------------------------------------------------
% IV) Shock processes
%--------------------------------------------------------------------------

shocks;
    var eM  = stdM^2;
    var eP  = stdP^2;
    var eZ  = stdZ^2;
    var eX  = stdX^2;
    var eV  = stdV^2;
    var eC  = stdC^2;
@#if fiscal == 1
    var eT  = stdT^2;
    var eL  = stdL^2;
@#endif
end;

%--------------------------------------------------------------------------
% VI) Simulation
%--------------------------------------------------------------------------

stoch_simul(order=@{approx_order},
            nodisplay,
            nograph,
            noprint,
            pruning,
            irf=@{irf_periods},
            periods=@{sim_periods},
            replic=@{replic_number},
            simul_replic=@{simul_replic_number},
            drop=@{drop_number}
            );

send_endogenous_variables_to_workspace ;
send_exogenous_variables_to_workspace ;
send_irfs_to_workspace ;

%----------------------------- End of File --------------------------------
